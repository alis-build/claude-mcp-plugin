{
  "description": "AlisX: Alis Build context at session start, wake-word routing, a gate that asks before destructive Alis Build calls and refuses ones carrying secrets, secret warnings and skill feedback prompts. Every hook is a local bash script; none sends anything over the network.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/route-prompt.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_alisx_alis__.+|.+__(search_skills|list_skills|preview_skill|load_skill|read_skill_file|list_skill_revisions|request_skill|send_skill_feedback|create_skill|update_skill|restore_skill_version|delete_skill|list_conversations|search_conversations|get_conversation|read_attachment|wait_for_reply|start_conversation|send_message|resolve_conversation|reopen_conversation))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/gate-tools.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/warn-secrets.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__.+__load_skill$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/note-skill.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
