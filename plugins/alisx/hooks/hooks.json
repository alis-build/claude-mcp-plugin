{
  "description": "AlisX: Alis Build context at session start, wake-word routing, a permission gate for the Alis MCP server's tools, secret warnings and skill feedback prompts. Every hook is a local bash script; none sends anything over the network.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/route-prompt.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_alisx_alis__",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/gate-tools.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/warn-secrets.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__plugin_alisx_alis__load_skill$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/note-skill.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
